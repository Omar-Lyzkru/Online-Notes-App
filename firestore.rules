rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ownership comes from the path (users/{uid}), never from a client-supplied field.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'content', 'rev', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() <= 500
        && d.content is string && d.content.size() <= 500000
        && d.rev is int
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    // Appearance preferences: one document per user, a fixed set of choices (keep in sync with src/appearance.ts).
    function validPrefs() {
      let d = request.resource.data;
      return d.keys().hasOnly(['theme', 'background', 'fontSize', 'updatedAt'])
        && d.theme in ['light', 'dark']
        && d.background in ['plain', 'paper', 'mint', 'sky', 'rose']
        && d.fontSize in ['small', 'medium', 'large', 'xlarge']
        && d.updatedAt == request.time;
    }

    match /users/{uid}/preferences/appearance {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPrefs();
    }

    match /users/{uid}/notes/{noteId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validShape() && request.resource.data.rev == 1;
      // Optimistic concurrency: a write must be based on the current revision, so stale writes fail.
      allow update: if isOwner(uid) && validShape()
        && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
