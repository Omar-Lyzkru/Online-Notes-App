# Copy to .env.local. Web config values are not secrets, but never commit service-account keys.
VITE_FIREBASE_API_KEY=
# Required for a live project (usually <project-id>.firebaseapp.com). Emulator mode falls back to "localhost" when empty.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set to "true" to talk to local emulators (auth :9099, firestore :8080) instead of a live project.
VITE_USE_EMULATORS=true
