# LOCAL DEVELOPMENT. Usually no env file is needed: `npm run dev` uses the local emulators by default
# (Auth :9099, Firestore :8080; start them with `npm run emulators`).
# Never put values for a production build in .env.local — Vite also reads it for `npm run build`.
# To point the dev server at a live Firebase project instead, copy this to .env.development.local (dev server only)
# and fill in the web config (see .env.production.example for the shape) with VITE_USE_EMULATORS=false.
# Web config values are not secrets, but NEVER put service-account keys, admin tokens or private keys in any VITE_* variable
# or file in this repo: VITE_* values are shipped to every browser.
VITE_USE_EMULATORS=true
